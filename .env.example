# ──────────────────────────────────────────────
# TradeMind — Environment Variables Template
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# ── Database (Supabase PostgreSQL via Drizzle ORM) ──
# Local dev: postgresql://postgres:postgres@127.0.0.1:5433/trademind
# Supabase pooler (prod): postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase (Auth, Storage & Database) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Application URL (Single source of truth) ─────
# Local: http://localhost:3000 | Prod: https://tradermind-web.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Security & Worker Secrets ────────────────────
# Internal secret shared between Supabase Edge Functions & Next.js
INTERNAL_WORKER_SECRET=your-32-byte-hex-worker-secret
# AES-256 encryption key for broker credentials (generate: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ── Environment ──────────────────────────────────
NODE_ENV=development

# ── Optional: Third-Party Integrations ───────────
# Payments (Razorpay)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# Email (Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# AI Providers
# GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key

# Real-Time Market News & Economic Calendar (Finnhub)
# FINNHUB_API_KEY=your-finnhub-api-key
# NEXT_PUBLIC_FINNHUB_API_KEY=your-finnhub-api-key

